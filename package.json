{
  "name": "socials-entradas-workspace",
  "private": true,
  "scripts": {
    "setup": "node scripts/configurar-docker.cjs",
    "test:integration": "node verificar-docker.cjs",
    "test:bcv": "node --test tests/bcv-money.test.cjs && node verificar-bcv-origen.cjs",
    "docker:up": "docker compose up -d --build --wait",
    "docker:down": "docker compose down",
    "build:admin": "tailwindcss -c scripts/admin-tailwind.config.cjs -i scripts/admin-tailwind.css -o sistema-central/public/admin/utilities.css --minify",
    "test:blog": "node --test tests/blog.test.cjs",
    "test:payments": "node --test tests/payments.test.cjs"
  },
  "devDependencies": {
    "jsqr": "^1.4.0",
    "pngjs": "^7.0.0",
    "socket.io-client": "^4.8.3",
    "tailwindcss": "^3.4.17"
  }
}
